# Everything here is OPTIONAL. On first run, open http://localhost:3456 and the
# setup screen will ask for a password and your OpenRouter key. Values set in
# this file override the ones entered in the browser.
#
# Copy to server/.env and keep it mode 600 in production.

# ── Credentials (optional: the setup screen covers both) ─────────────────────

# Access password every client sends as the X-App-Key header.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# OpenRouter key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────

# Listen address. 127.0.0.1 (default) = this machine only. Use 0.0.0.0 only
# when a firewall/reverse proxy controls who can reach the port.
HOST=127.0.0.1

# Server port. In production keep it closed to the public internet; only your
# reverse proxy (Nginx/Caddy/Traefik) should reach it.
PORT=3456

# Public origin used to build webhook + media URLs. For local use the default
# is right; in production set your domain, e.g. https://directcut.example.com
PUBLIC_BASE_URL=http://localhost:3456

# Hard daily cap in USD on the sum of today's generation costs (server-enforced).
DAILY_SPEND_CAP=10

# ── Optional features ────────────────────────────────────────────────────────

# OpenRouter chat model used by the ✦ Enhance button.
ENHANCE_MODEL=anthropic/claude-sonnet-5.5

# Secret embedded in the OpenRouter callback URL (needs a public
# PUBLIC_BASE_URL). If unset, a 60s fallback poller handles video completion.
WEBHOOK_SECRET=

# Video/audio references must reach OpenRouter over public https. When
# PUBLIC_BASE_URL isn't https, Directcut opens a temporary Cloudflare quick
# tunnel that serves only the reference files of active jobs, and closes it
# when they finish. Set to "off" to disable (those references then fail fast).
REF_TUNNEL=on

# Comma-separated browser origins allowed via CORS. Only needed when the UI is
# hosted on a different origin than the API (e.g. a static-host mirror).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Give up on video jobs OpenRouter hasn't resolved after this many hours.
POLL_MAX_AGE_HOURS=24

# If set, the server POSTs generation metadata here on first completion
# (fire-and-forget): handy for n8n/Zapier flows or cloud archiving.
COMPLETION_WEBHOOK_URL=
